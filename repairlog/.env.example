DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=psql://repairlog:repairlog@db:5432/repairlog
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# Нужны только для docker-compose.prod.yml (см. README → Деплой).
# В продакшене также переопределите значения выше: DEBUG=False,
# SECRET_KEY на случайное значение, ALLOWED_HOSTS и CSRF_TRUSTED_ORIGINS
# на реальный домен (https://...), SECURE_SSL_REDIRECT=True.
POSTGRES_DB=repairlog
POSTGRES_USER=repairlog
POSTGRES_PASSWORD=change-me-too
DOMAIN=repairlog.example.com
SECURE_HSTS_SECONDS=0
